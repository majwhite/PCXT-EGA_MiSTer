# Functional PC3086 revision using the current shared project/source lists.
source PCXT-EGA.qsf

set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name VERILOG_MACRO "PC3086_LEGACY_RTC=1"
set_global_assignment -name VERILOG_MACRO "PC3086_LEGACY_PPI=1"
set_global_assignment -name VERILOG_MACRO "PC3086_KEEP_DISK_CHANGE=1"

# The RTC seed is one-shot per FPGA configuration, not reset by the guest.
# Quartus 17 exposes this as a revision-wide setting, not a node assignment.
# Preserve declared initial states despite the shared project's global ON.
set_global_assignment -name ALLOW_POWER_UP_DONT_CARE OFF
